    {
      "id": "claim_19ec6e9fefd14b119e4a6548810793fa",
      "statement": "sparkrun only sees its own containers, so any other container on a node consumes unified memory and silently shrinks an auto-sized context; docker ps and memory should be checked on both nodes before a large launch.",
