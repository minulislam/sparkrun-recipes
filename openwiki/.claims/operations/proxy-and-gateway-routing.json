    {
      "id": "claim_ac6370c102d94140a4c199439882ef88",
      "statement": "SparkRoute bindings live only in ~/.config/sparkrun/proxy.yaml; there is no CLI add/remove command, and sparkrun proxy sync makes the running gateway match the file atomically.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md",
          "version": "repo-file-v1:sha256:f2f1953df8b4c91f74ec62b952796964871f05b4b7cd44fe62ac92cd8bb50609"
        }
      ]
    },
    {
      "id": "claim_fd2d49edcc334518b61b0f7f6388f3ec",
      "statement": "The SparkRoute binding schema (fields: recipe, cluster/cluster_candidates, cold_start wait|reject, model, overrides, capabilities) is documented authoritatively by the installed plugin source at ~/.config/sparkrun/plugins/sparkroute/*/payload/, not upstream docs.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md",
          "version": "repo-file-v1:sha256:f2f1953df8b4c91f74ec62b952796964871f05b4b7cd44fe62ac92cd8bb50609"
        }
      ]
    },
    {
      "id": "claim_8bfd6ee6b3764936852bbbd36dbd910d",
      "statement": "Bindings reference recipes in qualified @spark-forge/<recipe> form because plain names are ambiguous between the local checkout and the spark-forge registry.",
