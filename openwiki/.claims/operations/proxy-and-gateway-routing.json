    {
      "id": "claim_0aa6b153127e48ec9a89c0583f1c29d4",
      "statement": "All bindings use cold_start: wait so requests queue through multi-minute model swaps instead of erroring; idle-node-first placement is encoded via cluster_candidates order because SparkRoute 0.3.4 has no preempt-on-demand and eviction happens only via gateway idle timers on gateway-owned jobs.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md",
          "version": "repo-file-v1:sha256:f2f1953df8b4c91f74ec62b952796964871f05b4b7cd44fe62ac92cd8bb50609"
