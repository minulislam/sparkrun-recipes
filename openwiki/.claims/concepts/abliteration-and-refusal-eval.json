    {
      "id": "claim_a08698c2f7f64287a1f7724611b8518c",
      "statement": "The runtime refusal-projection image bakes a ~758 KB refusal_dirs.safetensors, is inert unless VLLM_REFUSAL_DIRS is set, boots at lambda 0, and has its strength set at runtime over HTTP, making the degree of abliteration a tunable serving parameter rather than a fixed weight property.",
      "evidence": [
        {
          "resource": "repo://images/deepseek-rank1/README.md#L9-L28",
          "version": "repo-lines-v1:sha256:a265805d9084d209d31dce4e0b8452a977ecaafa0f8a69453b95f0792f2b6eb4:"
        }
