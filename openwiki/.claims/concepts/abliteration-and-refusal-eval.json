    },
    {
      "id": "claim_3d9379ec316144b8ab5c08f982d194dd",
      "statement": "Refusal behavior is measured with JailbreakBench JBB-Behaviors (100 harmful across 10 policy categories plus 100 category-matched benign controls), using prompts from the published benchmark so results are comparable to the JailbreakBench literature.",
      "evidence": [
        {
          "resource": "repo://benchmarks/redteam/README.md#L10-L29",
          "version": "repo-lines-v1:sha256:d20ca8802dab221c1245e37594896f84439d938ca237fb7d331ba37a57fd2797:"
        }
