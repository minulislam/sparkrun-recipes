  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Running model: payload forwarded, `model` rewritten to the served name; response relayed, hop-by-hop headers dropped",
        "Cold model: one single-flight load per name; the request waits, a streaming request gets SSE `: loading` keep-alives",
        "Static pair: `/v1/embeddings` and `/v1/rerank` go straight to the pinned endpoints, never through LiteLLM"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cold load sequence",
      "items": [
        "`workloads.plan` per candidate cluster, then every host needs MemFree >= gpu_memory_utilization x MemTotal + 4 GiB",
        "`workloads.ensure_ready` (up to 30 min), then `proxy.sync` restarts LiteLLM so it lists the new model",
        "Poll up to 60 s for the daemon view + LiteLLM `/v1/models`; on timeout the request falls back (`registration_timeout`)"
      ]
    },
    {
      "dot": "rose",
      "title": "Fallback & idle stop",
      "items": [
        "Chat falls back to `default` (largest running chat model) with an `x-spark-loader-fallback: reason=` header; embedding / rerank get a 503",
        "A failed launch cools the model down for 900 s; leftover unhealthy workloads owned by the loader are stopped",
        "A loader-started chat model idle for 30 min is stopped via the daemon; vLLM `/metrics` catches traffic that bypasses the loader"
      ]
    }
  ]
